<?xml version="1.0" encoding="utf-8"?>
<!-- "P" for Priti whose stem is a download arrow, over a tray.
     Parts are spaced at least one stroke width apart so nothing touches,
     then scaled down around the centre to sit comfortably inside any launcher mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="55"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <!-- P bowl -->
        <path
            android:pathData="M46,26 L57,26 A11,11 0 0,1 57,48 L46,48"
            android:strokeWidth="6"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- P stem as download arrow; the head sits well below the bowl -->
        <path
            android:pathData="M46,26 L46,72 M39,65 L46,72 L53,65"
            android:strokeWidth="6"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- tray, clear of the arrow tip -->
        <path
            android:pathData="M32,76 L32,81 Q32,84 35,84 L73,84 Q76,84 76,81 L76,76"
            android:strokeWidth="6"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
